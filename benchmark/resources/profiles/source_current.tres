[gd_resource type="Resource" script_class="HairBenchmarkProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://benchmark/resources/hair_benchmark_profile.gd" id="1_profile_script"]

[resource]
script = ExtResource("1_profile_script")
profile_id = &"source_current"
display_name = "Current source profile"
notes = "Canonical baseline mirroring the current production hair shader interface (hair.gdshader defaults): albedo 0.1, longitudinal_roughness 0.3, azimuthal_roughness 0.8, specular 1.0, cuticle_tilt_offset 0.1, plus the Tier-2 Fast Marschner values (hair_marschner_fast.gdshaderinc defaults): absorption_mode 0, absorption 0.1, eumelanin 0.2, pheomelanin 0.8, melanin_absorption_scale 0.001, ior 1.55. Per-groom material overrides (textures and albedo colors) still come from the cloned source materials; this profile is the identity baseline for the profile adapter."
preserve_source_parameters = true
albedo = Color(0.1, 0.1, 0.1, 1)
longitudinal_roughness = 0.3
azimuthal_roughness = 0.8
cuticle_tilt_offset = 0.1
specular = 1.0
absorption_mode = 0
absorption = Color(0.1, 0.1, 0.1, 1)
eumelanin = 0.2
pheomelanin = 0.8
melanin_absorption_scale = 0.001
ior = 1.55
