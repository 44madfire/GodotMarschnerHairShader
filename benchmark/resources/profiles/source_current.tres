[gd_resource type="Resource" script_class="HairBenchmarkProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://benchmark/resources/hair_benchmark_profile.gd" id="1_profile_script"]

[resource]
script = ExtResource("1_profile_script")
profile_id = &"source_current"
display_name = "Current source profile"
notes = "Canonical baseline mirroring the current production hair shader interface (hair.gdshader defaults): albedo 0.1, longitudinal_roughness 0.3, azimuthal_roughness 0.8, specular 1.0, cuticle_tilt_offset 0.1. Per-groom material overrides (textures and albedo colors) still come from the cloned source materials; this profile is the identity baseline for the upcoming profile adapter."
albedo = Color(0.1, 0.1, 0.1, 1)
longitudinal_roughness = 0.3
azimuthal_roughness = 0.8
cuticle_tilt_offset = 0.1
specular = 1.0
index_of_refraction = 1.55
