[gd_resource type="Resource" script_class="BenchmarkSuite" load_steps=5 format=3]

[ext_resource type="Script" path="res://benchmark/resources/benchmark_suite.gd" id="1_benchmark_suite"]
[ext_resource type="Resource" path="res://benchmark/cases/blowout_capture_frozen_baseline.tres" id="2_frozen_baseline"]
[ext_resource type="Resource" path="res://benchmark/cases/blowout_capture_approximate_kajiya_kay.tres" id="3_approximate_kajiya_kay"]
[ext_resource type="Script" path="res://benchmark/resources/benchmark_case.gd" id="4_benchmark_case"]

[resource]
resource_name = "Benchmark capture smoke suite"
script = ExtResource("1_benchmark_suite")
id = &"capture_smoke_suite"
display_name = "Benchmark capture smoke suite"
cases = Array[ExtResource("4_benchmark_case")]([ExtResource("2_frozen_baseline"), ExtResource("3_approximate_kajiya_kay")])
output_subdirectory = "capture_smoke_suite"
